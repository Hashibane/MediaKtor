{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "groupName": "minor versions and patches",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "matchPackageNames": ["*logging*", "*mock*"],
      "groupName": "tests",
      "enabled": false
    },
    {
      "matchPackageNames": ["*ktor*", "*kotlinx*", "*logback*", "*serialization*"],
      "groupName": "samples",
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "matchPackageNames": ["*gradle*", "*kotlin.jvm*", "*jdk*"],
      "groupName": "kotlin/jvm/gradle",
      "matchUpdateTypes": [
        "major"
      ]
    }
  ]
}